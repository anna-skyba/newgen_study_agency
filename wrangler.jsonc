{
  "name": "newgen-study-agency",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist/newgen-study/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "LEAD_LIMIT",
      "namespace_id": "4101",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
